# FINWISE AI Configuration Environment Variables

# Application
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=finwise-super-secret-jwt-encryption-key-change-in-production
JWT_SECRET_KEY=finwise-jwt-security-key-production-change-2025

# Database Configuration (PostgreSQL / Supabase or SQLite fallback)
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Local Development default fallback:
DATABASE_URL=sqlite:///finwise_dev.db

# Groq AI API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative models: llama-3.1-8b-instant, mixtral-8x7b-32768

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload
